{
  "name": "training-plan-platform",
  "productName": "Sharp Fit",
  "version": "1.2.3",
  "description": "Sharp Fit - Training Plan Management Platform for Strength & Conditioning Coaches",
  "main": "main.js",
  "author": "Coach",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --mac dir",
    "dist": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "echarts": "^5.5.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^29.1.1",
    "ws": "^8.22.0"
  },
  "build": {
    "appId": "com.coach.sharpfit",
    "productName": "Sharp Fit",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "db-guard.js",
      "tokens.css",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.sports",
      "icon": "build/icon.icns",
      "identity": null
    },
    "dmg": {
      "title": "Sharp Fit",
      "artifactName": "Sharp Fit-${version}-${arch}.dmg"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon_1024.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Sharp-Fit-${version}-Windows-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        { "target": "AppImage", "arch": ["x64", "arm64"] },
        { "target": "deb", "arch": ["x64", "arm64"] }
      ],
      "icon": "build/icon_1024.png",
      "category": "Sports",
      "artifactName": "Sharp-Fit-${version}-Linux-${arch}.${ext}",
      "maintainer": "Coach"
    }
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
